rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function myEmail() { return isAuth() ? request.auth.token.get('email', '') : ''; }
    function isSuper() {
      return isAuth() && (
         myEmail() == 'blackviran@gmail.com' ||
         myEmail() == 'freelancerviran@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'super_support')
      );
    }
    function isMine(uid) { return isAuth() && request.auth.uid == uid; }

    // VERIFIED SELLERS ONLY: Pro (verified) members, client accounts and
    // support can chat outside support + the group chat. Unverified sellers
    // are limited to support chat and RwandaGroupChat.
    function isProMember() {
      return exists(/databases/$(database)/documents/proStatus/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/proStatus/$(request.auth.uid)).data.get('active', false) == true &&
        get(/databases/$(database)/documents/proStatus/$(request.auth.uid)).data.get('expiresAt', 0) is number &&
        get(/databases/$(database)/documents/proStatus/$(request.auth.uid)).data.expiresAt > request.time.toMillis();
    }
    function canChatFreely() {
      return isSuper() || isProMember() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountType', 'both') == 'client');
    }

    // Escrow deal receipt (transactions/dealEscrow_<dealId>) — helper for deal
    // funding checks. Returns the receipt doc data; get() on a missing doc
    // throws, which makes the whole rule deny (safe default).
    function dealReceipt(dealId) {
      let receiptId = ('dealEscrow_' + dealId);
      return get(/databases/$(database)/documents/transactions/$(receiptId)).data;
    }

    // Profiles: support-managed, plus self-registration (own doc, locked safe values).
    // Support can still change ANYTHING on any account afterwards.
    match /users/{uid} {
      allow get: if isMine(uid) || isSuper();
      allow list: if isSuper() || (isAuth() && request.query.limit <= 500);
      allow create: if isSuper() || (isAuth()
        && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.suspended == false
        && request.resource.data.phoneVerified == false
        && request.resource.data.email.lower() == myEmail().lower());
      allow update: if isSuper() || (
        isMine(uid) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['payoutMethod', 'payoutAccount', 'flutterwaveId', 'updatedAt', 'displayName', 'company', 'location', 'website', 'bio', 'photoURL', 'handle', 'accountType', 'isCompany', 'tagline', 'skills', 'languages', 'availability', 'hourlyRate', 'introVideo', 'balance'])
      );
      allow delete: if isSuper();
    }

    // Buyer library: users/{uid}/purchases/{orderId}. Support (and only
    // support) writes it when a digital/course order is verified — that is
    // what unlocks delivery links + access codes for the buyer.
    match /users/{uid}/purchases/{pid} {
      allow get, list: if isMine(uid) || isSuper();
      // Buyers may only flip status (confirm delivery / report a problem);
      // creating, deleting and editing anything else stays support-only.
      allow update: if isSuper() || (isMine(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'issueNote', 'confirmedAt'])
        && request.resource.data.status in ['received', 'issue']);
      allow create, delete: if isSuper();
    }

    // Business products: public storefront (anyone can browse a shop without
    // login); the owner or support can create/edit/remove items.
    match /products/{id} {
      allow get: if true;
      allow list: if true;
      allow create: if (isSuper() || (isAuth() && request.auth.uid == request.resource.data.ownerUid))
        && request.resource.data.price is number && request.resource.data.price > 0
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.status == 'active';
      allow update: if isSuper() || (isAuth() && resource.data.ownerUid == request.auth.uid);
      allow delete: if isSuper() || (isAuth() && resource.data.ownerUid == request.auth.uid);
      // Private delivery info (links/access codes for digital goods & courses):
      // NEVER public — only the product owner and support. This is what stops
      // strangers from downloading courses without paying.
      match /private/{docId} {
        allow get: if isSuper() || (isAuth() && request.auth.uid == get(/databases/$(database)/documents/products/$(id)).data.ownerUid);
        allow list: if isSuper() || (isAuth() && request.auth.uid == get(/databases/$(database)/documents/products/$(id)).data.ownerUid);
        allow create, update: if isSuper() || (isAuth() && request.auth.uid == get(/databases/$(database)/documents/products/$(id)).data.ownerUid);
        allow delete: if isSuper();
      }
    }

    // Profile + gig analytics: anyone signed in reads (same model as ledger
    // lists); writes are the viewer themselves (or anonymous pings with no PII).
    match /profileViews/{id} {
      allow get, list: if isSuper() || isAuth();
      allow create: if (isAuth() && (request.resource.data.viewerUid == request.auth.uid || request.resource.data.viewerUid == 'anon'))
        || (request.resource.data.viewerUid == 'anon'
          && request.resource.data.keys().hasOnly(['targetUid', 'handle', 'viewerUid', 'createdAt']));
      allow update, delete: if isSuper();
    }
    match /projectViews/{id} {
      allow get, list: if isSuper() || isAuth();
      allow create: if (isAuth() && (request.resource.data.viewerUid == request.auth.uid || request.resource.data.viewerUid == 'anon'))
        || (request.resource.data.viewerUid == 'anon'
          && request.resource.data.keys().hasOnly(['projectId', 'projectTitle', 'viewerUid', 'createdAt']));
      allow update, delete: if isSuper();
    }

    // Safety reports (copied gigs, scams, abuse): reporter + support read;
    // only support decides.
    match /reports/{id} {
      allow get: if isSuper() || (isAuth() &&
        (resource.data.reporterUid == request.auth.uid || resource.data.targetUid == request.auth.uid));
      allow list: if isSuper() || isAuth();
      allow create: if isAuth() && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update, delete: if isSuper();
    }

    // Public reviews on @ profiles: anyone reads; signed-in members (not the
    // owner) can leave one; authors and support can remove.
    match /reviews/{id} {
      allow get: if true;
      allow list: if true;
      allow create: if isAuth()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() > 0;
      allow update: if false;
      allow delete: if isSuper() || (isAuth() && resource.data.authorUid == request.auth.uid);
    }

    // Shop orders via MoMo/card: platform collects first, support verifies,
    // then seller gets 70% + platform 30%.
    match /orders/{id} {
      allow get: if isSuper() || (isAuth() &&
        (resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid));
      allow list: if isSuper();
      allow create: if isAuth() && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isSuper();
    }

    // Tips via MoMo/card ($0.5–$1000): money reaches the platform wallet
    // first, so support verifies the receipt, then the creator gets 100%.
    match /tips/{id} {
      allow get: if isSuper() || (isAuth() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid));
      allow list: if isSuper();
      allow create: if isAuth() && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isSuper();
    }

    // Wallet top-ups via PataLink (MoMo Rwanda / card abroad): members file
    // their MoMo/card transaction, support confirms and credits the wallet.
    match /topups/{id} {
      allow get: if isSuper() || (isAuth() && resource.data.userId == request.auth.uid);
      allow list: if isSuper() || (isAuth() && request.query.limit <= 20);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['pending', 'completed'];
      allow update: if isSuper() || (
        isAuth() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'cancelled' && resource.data.status == 'pending'
      );
      allow delete: if isSuper();
    }

    // Pro membership (Monthly $20 / 3 months $45 / Yearly $90): members
    // records the ledger debit. Status docs are PUBLIC (badge + ranking).
    match /proRequests/{id} {
      allow get: if isSuper() || (isAuth() && resource.data.userId == request.auth.uid);
      allow list: if isSuper() || (isAuth() && request.query.limit <= 20);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.plan in ['pro_monthly', 'pro_quarterly', 'pro_yearly'];
      allow update: if isSuper() || (
        isAuth() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'cancelled' && resource.data.status == 'pending'
      );
      allow delete: if isSuper();
    }

    match /proStatus/{uid} {
      allow get: if true;
      allow list: if isSuper();
      allow create, update, delete: if isSuper();
    }

    // Public @handles: remotetasks.world/@viran. The handles doc holds ONLY
    // the public card (name, bio, company, badges) — phones/emails/payouts
    // stay in users/ and are never readable by strangers.
    match /handles/{hid} {
      allow get: if true;
      allow list: if true;
      allow create: if (isSuper() || (isAuth() && request.resource.data.uid == request.auth.uid))
        && hid == request.resource.data.handle
        && hid.matches('^[a-z0-9_]{3,20}$')
        && !exists(/databases/$(database)/documents/handles/$(hid));
      allow update: if isSuper() || (isAuth()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle == hid);
      allow delete: if isSuper() || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // Ledger: owner reads own; creates own transfer_out; transfer_in credit
    // allowed when it matches a committed transfer doc. Everything else: support.
    match /transactions/{id} {
      allow get: if isSuper() || (isAuth() && resource.data.userId == request.auth.uid);
      allow list: if isSuper() || isAuth();
      allow create: if isSuper() || (
        isAuth() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.category == 'transfer_out'
      ) || (
        isAuth() && request.resource.data.category == 'transfer_in' &&
        request.resource.data.amount == get(/databases/$(database)/documents/transfers/$(request.resource.data.transferId)).data.amount &&
        get(/databases/$(database)/documents/transfers/$(request.resource.data.transferId)).data.toUid == request.resource.data.userId
      ) || (
        // Project escrow: client locks the FULL budget (fixed doc id escrow_<projectId>).
        isAuth() && request.resource.data.category == 'project_escrow'
        && id == 'escrow_' + request.resource.data.projectId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.kind == 'debit'
        && request.resource.data.status == 'completed'
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.amount == get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.budget
        && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.clientId == request.auth.uid
      ) || (
        // Deal escrow: buyer locks a chat-agreed deal (fixed id dealEscrow_<dealId>).
        isAuth() && request.resource.data.category == 'deal_escrow'
        && request.resource.data.kind == 'debit'
        && request.resource.data.status == 'completed'
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && id == 'dealEscrow_' + request.resource.data.dealId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount == get(/databases/$(database)/documents/deals/$(request.resource.data.dealId)).data.amount
        && get(/databases/$(database)/documents/deals/$(request.resource.data.dealId)).data.buyerUid == request.auth.uid
      );
      allow delete: if isSuper();
      allow update: if isSuper() || (
        // Buyer delivery-confirmation: releases the seller's HELD sale money.
        // Only that one doc (tagged buyerUid), status flip held -> completed.
        isAuth() && resource.data.get('buyerUid', '') == request.auth.uid
        && resource.data.get('status', '') == 'held'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'completed'
      );
    }

    match /transfers/{id} {
      allow get: if isSuper() || (isAuth() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid));
      allow list: if isSuper() || isAuth();
      allow create: if isAuth() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if isSuper();
    }

    // Withdrawals: owner creates/reads own; support decides.
    match /withdrawals/{id} {
      allow get: if isSuper() || (isAuth() && resource.data.userId == request.auth.uid);
      allow list: if isSuper() || isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isSuper() || (
        isAuth() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'cancelled' && resource.data.status == 'pending'
      );
      allow delete: if isSuper();
    }

    // Money requests: involved parties read; sender creates; recipient updates status.
    match /moneyRequests/{id} {
      allow get: if isSuper() || (isAuth() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid));
      allow list: if isSuper() || isAuth();
      allow create: if isAuth() && request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.status == 'open';
      allow update: if isSuper() || (isAuth() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isSuper();
    }

    // OTPs: owner creates/reads own; support reads pending (dev relay).
    match /otps/{id} {
      allow get: if isSuper() || (isAuth() && resource.data.userId == request.auth.uid);
      allow list: if isSuper() || isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isSuper() || (isAuth() && resource.data.userId == request.auth.uid);
      allow delete: if isSuper();
    }

    match /auditLogs/{id} {
      allow read: if isSuper();
      allow create: if isSuper();
    }

    // Projects marketplace: clients post as pending_funding and the project
    // goes live (open) ONLY after the full budget is escrowed from the
    // client's wallet. Browsing is public like Fiverr (homepage shows fresh
    // projects before login); writes stay restricted.
    match /projects/{id} {
      allow get: if true;
      allow list: if true;
      allow create: if isSuper() || (isAuth()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pending_funding'
        && request.resource.data.imageURLs is list
        && request.resource.data.imageURLs.size() >= 1
        && request.resource.data.imageURLs.size() <= 4);
      allow update: if isSuper() || (isAuth()
        && resource.data.clientId == request.auth.uid && (
          // Ordinary edits keep the status (budget locked once funded).
          (request.resource.data.status == resource.data.status
            && (resource.data.status != 'open' || request.resource.data.budget == resource.data.budget))
          // Publishing: only with the escrow receipt in place.
          || (resource.data.status == 'pending_funding' && request.resource.data.status == 'open'
            && exists(/databases/$(database)/documents/projects/$(id)/escrow/deposit))
        ));
      allow delete: if isSuper() || (isAuth()
        && resource.data.clientId == request.auth.uid
        && resource.data.status == 'pending_funding');

      // Escrow receipt (fixed id 'deposit'): proof the budget left the wallet.
      match /escrow/{eid} {
        allow get, list: if isAuth();
        allow create: if isAuth() && eid == 'deposit'
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.amount == get(/databases/$(database)/documents/projects/$(id)).data.budget
          && get(/databases/$(database)/documents/projects/$(id)).data.clientId == request.auth.uid;
        allow update, delete: if isSuper();
      }
    }

    // Affiliate project codes: owner creates/reads own; code lookups work
    // for everyone (pretty /p/ share links resolve with limit-1 queries).
    match /affiliateCodes/{id} {
      allow get: if true;
      allow list: if isAuth() || request.query.limit <= 1;
      allow create: if isAuth() && request.resource.data.affiliateId == request.auth.uid;
      allow update, delete: if isSuper();
    }

    // Applications: freelancer creates own WITH photos (business reviews them);
    // client/support updates status; support all.
    match /applications/{id} {
      allow get, list: if isAuth();
      allow create: if isSuper() || (isAuth()
        && request.resource.data.freelancerId == request.auth.uid
        && request.resource.data.imageURLs is list
        && request.resource.data.imageURLs.size() >= 1
        && request.resource.data.imageURLs.size() <= 4);
      allow update: if isSuper() || (isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isSuper();
    }

    // Project chats: 1:1 freelancer <-> client per project. Support reads/writes all
    // and sends messages "as client".
    match /projectChats/{id} {
      allow get, list: if isAuth();
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isSuper() || (isAuth() && request.auth.uid in resource.data.participants);
      allow delete: if isSuper();
      match /messages/{mid} {
        // Invisible moderation: everyone sees approved (or legacy no-status);
        // pending is visible only to its sender + support. No badges in the app.
        allow get: if isSuper() || (isAuth() &&
          (resource.data.get('status', 'approved') == 'approved' || resource.data.senderId == request.auth.uid));
        allow list: if isSuper() || (isAuth() &&
          (resource.data.get('status', 'approved') == 'approved' || resource.data.senderId == request.auth.uid));
        allow create: if isSuper() || (isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/projectChats/$(id)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.get('status', 'pending') == 'pending'
          // Sellers can HIRE too: whoever is the client (poster/hirer) on this
          // specific chat can always talk in it, even if not Pro.
          && (canChatFreely() || request.auth.uid == get(/databases/$(database)/documents/projectChats/$(id)).data.clientId));
        allow update, delete: if isSuper();
      }
    }

    // Support chats: 1 thread per user (supportChats/{userId}).
    // Freelancer sees ONLY displayName chosen by support — never support identity.
    match /supportChats/{uid} {
      allow get, list: if isAuth();
      allow create: if isAuth() && (request.auth.uid == uid || isSuper());
      allow update: if isSuper() || (isAuth() && request.auth.uid == uid);
      allow delete: if isSuper();
      match /messages/{mid} {
        allow get, list: if isAuth();
        allow create: if isSuper() || (isAuth() && uid == request.auth.uid);
        allow update, delete: if isSuper();
      }
    }

    // RwandaGroupChat: all freelancers read + post; support manages + posts as any name.
    match /groupChats/{gid} {
      allow get, list: if isAuth();
      allow create, update: if isSuper();
      allow delete: if isSuper();
      match /messages/{mid} {
        allow get: if isSuper() || (isAuth() &&
          (resource.data.get('status', 'approved') == 'approved' || resource.data.senderId == request.auth.uid));
        allow list: if isSuper() || (isAuth() &&
          (resource.data.get('status', 'approved') == 'approved' || resource.data.senderId == request.auth.uid));
        allow create: if isSuper() || (isAuth()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.get('status', 'pending') == 'pending');
        allow update, delete: if isSuper();
      }
    }

    // Communities: up to 10 members, join by code, shared project + split pay.
    // Single docs are public (pretty /c/ invite links); member lists need sign-in.
    match /communities/{cid} {
      allow get: if true;
      allow list: if isAuth() || request.query.limit <= 1;
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= 10;
      // Member self-join (+1 self, max 10) or self-leave (−1 self).
      // Owner/support can edit anything.
      allow update: if isSuper() || (isAuth()
        && resource.data.ownerId == request.auth.uid) || (isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'updatedAt'])
        && request.resource.data.memberIds.size() <= 10
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && (request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1)
        && (request.auth.uid in request.resource.data.memberIds)) || (isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'shares', 'updatedAt'])
        && (request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1)
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && !(request.auth.uid in request.resource.data.memberIds));
      allow delete: if isSuper() || (isAuth() && resource.data.ownerId == request.auth.uid);
      match /messages/{mid} {
        allow get: if isSuper() || (isAuth() &&
          (resource.data.get('status', 'approved') == 'approved' || resource.data.senderId == request.auth.uid));
        allow list: if isSuper() || (isAuth() &&
          (resource.data.get('status', 'approved') == 'approved' || resource.data.senderId == request.auth.uid));
        allow create: if isSuper() || (isAuth() &&
          request.auth.uid in get(/databases/$(database)/documents/communities/$(cid)).data.memberIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.get('status', 'pending') == 'pending'
          && canChatFreely());
        allow update, delete: if isSuper();
      }
    }

    // Community applications: a freelancer community applies to work a project
    // together. Any member applies on behalf of the crew; support decides.
    match /communityApplications/{aid} {
      allow get, list: if isAuth();
      allow create: if isAuth()
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'applied'
        && request.auth.uid in get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)).data.memberIds;
      allow update: if isSuper() || (isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isSuper() || (isAuth()
        && resource.data.applicantUid == request.auth.uid
        && resource.data.status == 'applied');
    }

    // Community payouts: support-written receipts (idempotency).
    match /communityPayouts/{id} {
      allow get, list: if isAuth();
      allow create, update, delete: if isSuper();
    }

    // Gig detail pages (/gig/:id): public read, open comments for every
    // signed-in member; author or support can remove a comment.
    match /gigComments/{id} {
      allow get, list: if true;
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update: if false;
      allow delete: if isSuper() || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // NOTIFICATIONS: support writes (one doc per target user); the user reads
    // their own and marks read. Nothing else.
    match /notifications/{id} {
      allow get, list: if isSuper() || (isAuth() && resource.data.uid == request.auth.uid);
      allow create: if isSuper()
        && request.resource.data.uid is string && request.resource.data.uid != ''
        && request.resource.data.title is string && request.resource.data.title != ''
        && request.resource.data.title.size() <= 120
        && request.resource.data.body.size() <= 500
        && request.resource.data.keys().hasOnly(['uid', 'title', 'body', 'kind', 'read', 'createdAt', 'readAt'])
        && request.resource.data.kind in ['info', 'warn', 'money', 'deal']
        && request.resource.data.read == false;
      allow update: if isSuper() || (isAuth()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true);
      allow delete: if isSuper();
    }

    // FOLLOWS: a member follows/unfollows anyone; the edge doc id encodes it.
    // Public reads so profiles display counts (like handles).
    match /follows/{id} {
      allow get, list: if true;
      allow create: if isAuth()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && id == request.resource.data.followerUid + '_' + request.resource.data.targetUid;
      allow update: if isSuper();
      allow delete: if isSuper() || (isAuth() && resource.data.followerUid == request.auth.uid);
    }

    // ESCROW DEALS: buyer (chat client) opens one deal per chat (doc id == chatId).
    // status: awaiting_escrow -> funded (with ledger receipt) -> delivered ->
    // completed / refunded by the AGENT; cancelled by the buyer before funding.
    match /deals/{id} {
      allow get, list: if isSuper() || (isAuth() &&
        (resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid));
      allow create: if request.auth != null
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.chatId == id
        && request.resource.data.status == 'awaiting_escrow'
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.buyerUid != request.resource.data.sellerUid;
      allow update: if isSuper() || (request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) && (
          (resource.data.buyerUid == request.auth.uid
            && resource.data.status == 'awaiting_escrow'
            && request.resource.data.status == 'cancelled')
          || (resource.data.buyerUid == request.auth.uid
            && resource.data.status == 'awaiting_escrow'
            && request.resource.data.status == 'funded'
            && dealReceipt(id).amount == resource.data.amount
            && dealReceipt(id).userId == request.auth.uid)
          || (resource.data.sellerUid == request.auth.uid
            && resource.data.status == 'funded'
            && request.resource.data.status == 'delivered')
        ));
      allow delete: if isSuper();
    }

    // ESCROW REPORTS: the agent (support) writes the proof receipt; both
    // parties read it.
    match /escrowReports/{id} {
      allow get, list: if isSuper() || (isAuth() &&
        (resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid));
      allow create, update, delete: if isSuper();
    }

    // App settings (single docs): safety banner text — public get, support write.
    match /settings/{id} {
      allow get: if true;
      allow list: if isSuper();
      allow create, update, delete: if isSuper();
    }

    // Moderation queue: collectionGroup('messages') where status==pending.
    // Support-only list; nothing new for members (nested rules still govern them).
    match /{path=**}/messages/{mid} {
      allow get: if isSuper() || (isAuth() &&
        (resource.data.get('status', 'approved') == 'approved' || resource.data.senderId == request.auth.uid));
      allow list: if isSuper();
      allow create, update, delete: if false;
    }

    // Support threads (aviator-crash app): 1 thread per user, embedded messages.
    match /support_threads/{uid} {
      allow get, list: if isAuth();
      allow create: if isAuth() && (request.auth.uid == uid || isSuper());
      allow update: if isAuth() && (request.auth.uid == uid || isSuper());
      allow delete: if isSuper();
    }
  }
}
