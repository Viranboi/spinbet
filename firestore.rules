rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Server user registry + admin console for blackviran@gmail.com.
    // Deploy with: firebase deploy --only firestore:rules
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "blackviran@gmail.com" ||
        request.auth.token.admin == true
      );
    }
    match /users/{uid} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow update: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow delete: if false;
    }
    // pixcrate.store catalog: public reads for the storefront, admin-only writes.
    match /pixcrate_products/{id} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    // pixcrate.store vendor applications: anyone can apply, only admin reviews.
    match /pixcrate_applications/{id} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }
    // pixcrate.store refund requests: anyone can request, only admin reviews.
    match /pixcrate_refunds/{id} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
