{
  "rewrites": [
    {
      "source": "/api/patalink-status/:id",
      "destination": "/api/patalink-status?id=:id"
    }
  ],
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "react-app-rewired build",
  "outputDirectory": "build",
  "framework": null,
  "headers": [
    {
      "source": "/unity/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
